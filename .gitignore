# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
bin/
build/
dist/
*.egg-info/

# PyInstaller specs (track ocpp.spec, ignore generated ones)
*.spec
!ocpp.spec

# Virtual Environments
.venv/
.venv_win/
.venv_lin/
.venv_unx/
venv/
env/
ENV/

# Type checking and linting
.mypy_cache/
.pytest_cache/
.ruff_cache/

# IDEs
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Local environment variables
.env
.env.*

# ocpp project files (contain API keys)
.project
